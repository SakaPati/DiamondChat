{
  "schemaVersion": 1,
  "id": "diamondchat",
  "version": "${version}",
  "name": "DiamondChat",
  "description": "Разделение чатов по категориям, создано специально под сервер DiamondWorld",
  "authors": [
    "Fozeton"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/diamondchat",
    "sources": "https://github.com/SakaPati/DiamondChat",
    "issues": "https://github.com/SakaPati/DiamondChat/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/diamondchat/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ru.fozeton.diamondchat.DiamondChat"
    ]
  },
  "mixins": [
    "diamondchat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "evo-plus": ">=3.0.4",
    "chatmanager_core": ">=1.0-SNAPSHOT",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
